+static void gts_work_count_raw_selected_subtree(Subtree subtree) {
+  // The parser's finished tree retains a terminal EOF sentinel, while the
+  // compact accepted derivation does not. The paired raw-census contract
+  // excludes that transport sentinel on both sides.
+  if (ts_subtree_is_eof(subtree)) return;
+  gts_work_count_add(&gts_work_count_current.raw_selected_internal_nodes, 1);
+  uint32_t child_count = ts_subtree_child_count(subtree);
+  if (child_count == 0) {
+    gts_work_count_add(&gts_work_count_current.raw_selected_internal_leaf_occurrences, 1);
+    return;
+  }
+  gts_work_count_add(&gts_work_count_current.raw_selected_internal_parent_occurrences, 1);
+  const Subtree *children = ts_subtree_children(subtree);
+  for (uint32_t i = 0; i < child_count; i++) {
+    gts_work_count_raw_selected_subtree(children[i]);
+  }
+}
+
+static inline void gts_work_count_admit_action_arm(uint32_t *admitted, uint32_t action_count) {
+  if (action_count <= 1) return;
+  gts_work_count_add(&gts_work_count_current.conflict_action_arms_admitted, 1);
+  if ((*admitted)++ > 0) {
+    gts_work_count_add(&gts_work_count_current.causal_conflict_forks, 1);
+  }
+}
+
+bool gts_work_count_validate_action_model(void) {
+  gts_work_count_reset();
+  gts_work_count_add(&gts_work_count_current.per_version_lex_requests, 1);
+  gts_work_count_add(&gts_work_count_current.raw_main_lexer_invocations, 1);
+  gts_work_count_add(&gts_work_count_current.raw_main_lexer_invocations, 1);
+  gts_work_count_add(&gts_work_count_current.resolved_action_cells_examined, 1);
+  uint32_t admitted = 0;
+  gts_work_count_admit_action_arm(&admitted, 3);
+  // A repetition shift is ignored at the real action loop before this seam.
+  gts_work_count_admit_action_arm(&admitted, 3);
+  GTSWorkCount count = gts_work_count_snapshot();
+  return admitted == 2 &&
+    count.per_version_lex_requests == 1 &&
+    count.raw_main_lexer_invocations == 2 &&
+    count.resolved_action_cells_examined == 1 &&
+    count.conflict_action_arms_admitted == 2 &&
+    count.causal_conflict_forks == 1 &&
+    !count.overflow;
+}
+
+bool gts_work_count_validate_raw_census_model(void) {
+  typedef struct {
+    Subtree children[2];
+    SubtreeHeapData data;
+  } GTSRawCensusModel;
+  GTSRawCensusModel model = {0};
+  if (offsetof(GTSRawCensusModel, data) != sizeof(model.children)) return false;
+  model.children[0] = (Subtree) {.data = {.is_inline = true, .symbol = 1}};
+  model.children[1] = (Subtree) {.data = {.is_inline = true, .symbol = ts_builtin_sym_end}};
+  model.data = (SubtreeHeapData) {.ref_count = 1, .child_count = 2, .symbol = 1};
+  gts_work_count_reset();
+  gts_work_count_raw_selected_subtree((Subtree) {.ptr = &model.data});
+  GTSWorkCount count = gts_work_count_snapshot();
+  return count.raw_selected_internal_nodes == 2 &&
+    count.raw_selected_internal_parent_occurrences == 1 &&
+    count.raw_selected_internal_leaf_occurrences == 1 &&
+    !count.overflow;
+}

